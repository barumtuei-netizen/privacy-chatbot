# Local development only (`npm run dev` -> wrangler dev reads this file).
# In production these are Worker secrets: `wrangler secret put NAME`.
# See wrangler.toml for the non-secret settings.
ANTHROPIC_API_KEY=
RELAY_ALLOWED_ORIGIN=http://localhost:5173
ANTHROPIC_MODEL=claude-sonnet-5

# Required if this relay is ever reachable from outside localhost (e.g.
# hosted so you can reach it from your phone away from home). Leave blank
# for local-only dev. Once set, every request must send it in the
# `x-relay-key` header or gets 401 — otherwise anyone who finds the URL
# could spend your Anthropic/OpenAI quota for free. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_ACCESS_KEY=

# Optional: enables a second AI (answers the same message in parallel with
# Claude). When both have answered, Claude also gets a round 2: it sees the
# second brain's answer and reacts (agree/disagree/build on it).
# Leave blank to run with Claude only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional: enables the speaker button (text-to-speech) on assistant replies.
# Leave blank to hide it. Text is sent to Google's TTS API only when the user
# clicks the button on a specific message — never automatically.
GOOGLE_API_KEY=
GOOGLE_TTS_LANGUAGE=th-TH
GOOGLE_TTS_VOICE=th-TH-Chirp3-HD-Zephyr
