VITE_RELAY_URL=http://localhost:8787

# Local RAG embeddings (Ollama, runs on your own GPU). Defaults match a
# freshly pulled `ollama pull bge-m3`; RAG silently falls back to plain
# history windowing if Ollama or this model isn't available.
VITE_OLLAMA_URL=http://localhost:11434
VITE_EMBED_MODEL=bge-m3
